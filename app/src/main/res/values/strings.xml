    <string name="vpn_mode">VPN mode — all traffic through Tor</string>
    <string name="vpn_help">All apps go through Tor without proxy setup, DNS included. UDP (calls, games, QUIC) doesn\'t work over Tor — apps usually fall back to TCP.</string>
    <string name="vpn_active">VPN on: all traffic through Tor</string>
    <string name="bridges_title">Connecting to Tor</string>
    <string name="bridges_help">If connecting gets stuck at 5–10%, Tor is blocked for you — you need bridges. Auto tries every method until one works and remembers it.</string>
    <string name="bridge_auto">Auto — keep trying until connected (recommended)</string>
    <string name="bridge_direct">No bridges</string>
