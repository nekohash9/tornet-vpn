    <string name="bridge_snowflake">Snowflake — via volunteers, gets around most blocking</string>
    <string name="bridge_dnstt">dnstt — over Google DNS, slow but very hard to block</string>
    <string name="bridge_meek">meek — via CDN</string>
    <string name="bridge_custom">Custom bridges</string>
    <string name="custom_bridges_hint">Custom bridges (one per line)</string>
    <string name="custom_bridges_helper">obfs4, webtunnel, snowflake… Get them from the Telegram bot @GetBridgesBot, bridges.torproject.org or the button below. Auto tries them first.</string>
